# ── Generator ────────────────────────────────────────────────────────────────
ORDERS_PER_MIN_PEAK=5000
ORDERS_PER_MIN_BASE=1200
NUM_RIDERS=200
RIDER_GPS_INTERVAL_SEC=30

# ── GCS (Phase 1 — replaces MinIO) ───────────────────────────────────────────
# Path to your ADC credentials file (from: gcloud auth application-default login)
# Windows default: C:\Users\<YOU>\AppData\Roaming\gcloud\application_default_credentials.json
GOOGLE_ADC_PATH=C:\Users\<YOUR_USERNAME>\AppData\Roaming\gcloud\application_default_credentials.json

# ── Spark ─────────────────────────────────────────────────────────────────────
SPARK_WORKER_MEMORY=4G
SPARK_WORKER_CORES=2

# ── Airflow ───────────────────────────────────────────────────────────────────
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=supersecret

# ── ClickHouse ────────────────────────────────────────────────────────────────
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ── MinIO (internal Docker hostnames — change only if running outside Docker) ──
MINIO_ENDPOINT=http://minio:9000

# ── ClickHouse internal ────────────────────────────────────────────────────────
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_NATIVE_PORT=9000

# ── Airflow alerting ──────────────────────────────────────────────────────────
# Leave blank to disable email alerts entirely
AIRFLOW_ALERT_EMAIL=
# SMTP required only if AIRFLOW_ALERT_EMAIL is set
# Use a Gmail App Password (not your main password): myaccount.google.com/apppasswords
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
